{
  "name": "figma-bridge-cli",
  "version": "0.3.2",
  "description": "Figma design data for AI agents: a CLI for shell-only agents and a pi package (one compact tool) — no MCP, no desktop app",
  "readmeFilename": "README.md",
  "keywords": [
    "figma",
    "cli",
    "ai-agent",
    "llm",
    "mcp",
    "design-to-code",
    "agent",
    "pi-package",
    "pi-extension",
    "pi-coding-agent"
  ],
  "author": "SuTang-vain",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "figma-developer-mcp": "^0.13.2",
    "typebox": "^1.3.27"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "bin": {
    "figma-bridge": "bin/figma-bridge.js"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/SuTang-vain/figma-bridge/main/assets/demo.gif"
  },
  "files": [
    "bin",
    "src",
    "extensions",
    "skills",
    "docs/README.zh-CN.md",
    "BENCHMARKS.md",
    "assets/demo.gif"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuTang-vain/figma-bridge.git"
  },
  "homepage": "https://github.com/SuTang-vain/figma-bridge#readme",
  "bugs": "https://github.com/SuTang-vain/figma-bridge/issues",
  "engines": {
    "node": ">=18"
  }
}
